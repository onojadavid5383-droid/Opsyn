# ============================================================
# OPSYN ENVIRONMENT VARIABLES — .env.example
# Copy to .env and fill in real values before running.
# NEVER commit .env to version control.
# Powered by SlimTech
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME=Opsyn
# development | staging | production
ENVIRONMENT=development
DEBUG=false

# ── Database (PostgreSQL + asyncpg) ──────────────────────────
# Dev default — matches docker-compose.yml
DATABASE_URL=postgresql+asyncpg://opsyn:opsyn_dev_pass@localhost:5432/opsyn
# Production example (managed DB with SSL):
# DATABASE_URL=postgresql+asyncpg://user:pass@db.prod.example.com:5432/opsyn?ssl=require

# ── Redis ────────────────────────────────────────────────────
# Used for: rate limiting, refresh-token revocation list, Celery result backend
REDIS_URL=redis://localhost:6379/0
# Celery broker (separate DB index avoids key collisions)
CELERY_BROKER_URL=redis://localhost:6379/1
# Production example (Redis with password):
# REDIS_URL=redis://:your_redis_password@redis.prod.example.com:6379/0
# CELERY_BROKER_URL=redis://:your_redis_password@redis.prod.example.com:6379/1

# ── JWT Security ─────────────────────────────────────────────
# REQUIRED — must be at least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-real-secret-key-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Bcrypt ───────────────────────────────────────────────────
# Cost factor — 12 is recommended for production
BCRYPT_ROUNDS=12

# ── Email (SMTP) ──────────────────────────────────────────────
# SendGrid:
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.your_sendgrid_api_key_here
# Postmark example:
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_USER=your-postmark-server-token
# SMTP_PASSWORD=your-postmark-server-token
FROM_EMAIL=no-reply@yourcompany.com
FROM_NAME=Opsyn Platform

# ── Frontend / CORS ───────────────────────────────────────────
# URL the React frontend is served from (used in invite email links)
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed CORS origins
# Note: config field is ALLOWED_ORIGINS_STR (not ALLOWED_ORIGINS)
ALLOWED_ORIGINS_STR=http://localhost:5173
# Production example:
# ALLOWED_ORIGINS_STR=https://app.yourcompany.com,https://yourcompany.com

# ── Rate Limiting ────────────────────────────────────────────
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=900

# ── Monitoring (Sentry) ──────────────────────────────────────
# Leave blank to disable Sentry error tracking
SENTRY_DSN=

# ── Vite / Frontend env vars ─────────────────────────────────
# These are read by Vite at build time (prefix: VITE_)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Opsyn
# Polling interval for live data (milliseconds)
VITE_POLLING_INTERVAL=30000
# Basemap for the network maps: OpenStreetMap (tile.openstreetmap.org, no key,
# already allowed by the nginx CSP). For heavy production traffic, point this
# at your own OSM tile server / mirror and add its host to the CSP img-src.
# See frontend/src/lib/basemap.ts.
# VITE_BASEMAP_URL=https://tiles.example.com/{z}/{x}/{y}.png
# VITE_BASEMAP_ATTRIBUTION=© OpenStreetMap contributors
