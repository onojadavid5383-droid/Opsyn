# ============================================================
# OPSYN DOCKERFILE — Backend (Multi-stage)
# infrastructure/docker/Dockerfile.backend
#
# KEY FIX: venv is installed to /opt/venv (NOT inside /app)
# so the dev volume mount  ./backend:/app  never overwrites
# uvicorn, celery, or any installed package.
# ============================================================

# ── Stage 1: Builder ─────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build

# System build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc libpq-dev curl && \
    rm -rf /var/lib/apt/lists/*

# Create venv at /opt/venv — completely outside the app mount path
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install all Python dependencies from requirements.txt
COPY requirements.txt /build/requirements.txt
RUN pip install --no-cache-dir --retries 10 --timeout 120 --upgrade pip && \
    pip install --no-cache-dir --retries 10 --timeout 120 \
      -r /build/requirements.txt

# ── Stage 2: Runtime ─────────────────────────────────────────
FROM python:3.12-slim AS runtime

# Runtime system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 curl && \
    rm -rf /var/lib/apt/lists/*

# Copy venv from builder to /opt/venv
# This path is NEVER touched by the ./backend:/app volume mount
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

# Copy application source (overridden by volume mount in dev — that's fine)
COPY . .

# Non-root user
RUN addgroup --system opsyn && \
    adduser --system --ingroup opsyn opsyn && \
    chown -R opsyn:opsyn /app && \
    chown -R opsyn:opsyn /opt/venv

USER opsyn

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
